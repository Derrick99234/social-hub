# ==============================================================================
# 🔐 Access Passkeys / PINs (Founder & Marketer Roles)
# ==============================================================================
FOUNDER_PASSKEY=founder@hub2026
MARKETER_PASSKEY=marketer@hub2026

# ==============================================================================
# 🐦 Typefully API (X / Twitter & Threads Scheduling & Publishing)
# ==============================================================================
# Get your API key from Typefully Settings > Integrations / API
TYPEFULLY_API_KEY=your_typefully_api_key_here

# ==============================================================================
# 💼 Buffer API (LinkedIn & Instagram Publishing & Scheduling)
# ==============================================================================
# Buffer Access Token from https://buffer.com/developers/api
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
BUFFER_LINKEDIN_PROFILE_ID=your_linkedin_profile_id
BUFFER_INSTAGRAM_PROFILE_ID=your_instagram_profile_id

# ==============================================================================
# ⚡ Supabase (Database & Storage All-In-One)
# ==============================================================================
# Found in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=media
